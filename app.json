{
  "expo": {
    "name": "Pear Snake",
    "slug": "snake-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      ["pear-runtime-react-native/plugin"],
      ["./plugins/with-metro-port"],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#001601"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.snake-mobile",
      "appleTeamId": "99564YDV39"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001601"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.snakemobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
